# Obligatorio: mínimo 32 caracteres (genera uno con: openssl rand -base64 48)
JWT_SECRET=cambia-esta-clave-por-una-de-al-menos-32-caracteres
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL (obligatorio para backend, docker compose y liquibase)
POSTGRES_DB=eduaircontrol
POSTGRES_USER=tu_usuario_postgres
POSTGRES_PASSWORD=una_contrasena_segura_para_postgres
POSTGRES_URL=jdbc:postgresql://localhost:5432/eduaircontrol

# Primer administrador (se crea al arrancar si no existe)
# ADMIN_COMPANY_CODE debe cumplir el formato AAA-0000
ADMIN_EMAIL=admin@eduaircontrol.com
ADMIN_PASSWORD=Admin1234!
ADMIN_COMPANY_CODE=EDU-0001

# Contextos de Liquibase: 'dev' siembra ambientes/sensores/mediciones de ejemplo,
# vacio para un arranque solo con esquema + seeds referencia.
DB_CHANGELOG_CONTEXTS=dev

# Puertos/URL del compose (opcionales)
BACKEND_PORT=8080
VITE_API_URL=http://localhost:8080

# SMTP (recuperacion de contraseña). En docker compose se usa Mailpit local
# (UI http://localhost:8025); para prod pon tu proveedor real.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# Mailpit local no exige autenticacion ni STARTTLS; pon true con un proveedor real
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=no-reply@eduaircontrol.com
